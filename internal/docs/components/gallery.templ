package components

import (
	"github.com/miguel-raspberry-pi/popui.go/internal/docs/examples"
	"github.com/miguel-raspberry-pi/popui.go/internal/docs/modules"
)

templ Gallery() {
	@modules.Example(modules.ExampleProps{
		Description: "Gallery shows a large main image with a strip of lazy-loaded thumbnails. Click a thumbnail, the arrows or use the arrow keys to switch photos; click the photo to open a fullscreen viewer with previous/next, captions and a counter (Esc closes). The state lives in an Alpine.js scope; without JavaScript the first photo shows and links to the full-size file.",
		Code:        examples.LoadExample("gallery.templ"),
		Stacked:     true,
	}) {
		@examples.GalleryExample()
	}
	@modules.Example(modules.ExampleProps{
		Title:       "Empty and single image",
		Description: "With no images an empty state keeps the gallery's aspect ratio. A single image shows without thumbnails, arrows or counter. AspectClass sets the main image's ratio.",
		Code:        examples.LoadExample("gallery_empty.templ"),
		Stacked:     true,
	}) {
		@examples.GalleryEmptyExample()
	}
	@modules.Section("API Reference", "api") {
		@modules.APITable(modules.APITableProps{
			Title:       "Gallery",
			Description: "Photo gallery with thumbnails and a fullscreen viewer.",
			Items: []modules.APITableItem{
				{Name: "ID", Type: "string", Default: "", Description: "Unique identifier for the gallery"},
				{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to merge with gallery styles"},
				{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes"},
				{Name: "Images", Type: "[]props.GalleryImage", Default: "", Description: "Photos in order; the first shows initially"},
				{Name: "Empty", Type: "string", Default: "No photos", Description: "Title of the empty state shown without images"},
				{Name: "AspectClass", Type: "string", Default: "aspect-[4/3]", Description: "Tailwind aspect-ratio class of the main image box; photos are cropped to fill it"},
			},
		})
		@modules.APITable(modules.APITableProps{
			Title:       "GalleryImage",
			Description: "One photo of a Gallery.",
			Items: []modules.APITableItem{
				{Name: "Src", Type: "string", Default: "", Description: "URL of the full-size image", Required: true},
				{Name: "Thumb", Type: "string", Default: "Src", Description: "URL of a smaller version for the thumbnail strip"},
				{Name: "Alt", Type: "string", Default: "", Description: "Description for assistive technology"},
				{Name: "Caption", Type: "string", Default: "", Description: "Text under the main image and in the viewer"},
			},
		})
	}
}
