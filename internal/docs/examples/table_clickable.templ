package examples

import (
	"github.com/miguel-raspberry-pi/popui.go"
	"github.com/miguel-raspberry-pi/popui.go/props"
)

templ TableClickableExample() {
	@popui.Table() {
		<thead>
			<tr>
				<th>Product</th>
				<th>Status</th>
				<th>Price</th>
			</tr>
		</thead>
		<tbody>
			@popui.TableRow(props.TableRow{Href: "#widget-a"}) {
				<td>Widget A</td>
				<td>Available</td>
				<td>$29.99</td>
			}
			@popui.TableRow(props.TableRow{Href: "#widget-b"}) {
				<td>Widget B</td>
				<td>Out of Stock</td>
				<td>$39.99</td>
			}
			@popui.TableRow(props.TableRow{Href: "#widget-c"}) {
				<td>Widget C</td>
				<td>Available</td>
				<td>$49.99</td>
			}
		</tbody>
	}
}
