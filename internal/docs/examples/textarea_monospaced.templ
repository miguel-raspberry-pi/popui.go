package examples

import (
	"github.com/miguel-raspberry-pi/popui.go"
	"github.com/miguel-raspberry-pi/popui.go/props"
)

templ TextareaMonospacedExample() {
	@popui.Textarea(props.Textarea{
		Label:       "Code Snippet",
		Class:       "font-mono",
		Placeholder: "Enter code here...",
		Rows:        6,
	})
}
