package examples

import (
	"github.com/miguel-raspberry-pi/popui.go"
	"github.com/miguel-raspberry-pi/popui.go/props"
)

templ MenuExample() {
	@popui.Menu() {
		@popui.MenuItem() {
			Edit
		}
		@popui.MenuItem() {
			Duplicate
		}
		@popui.MenuItem() {
			Delete
		}
		@popui.MenuLabel() {
			Switch to
		}
		@popui.MenuItem(props.MenuItem{Selected: true}) {
			@popui.Avatar(props.Avatar{Initial: "P"})
			<span>Production</span>
		}
		@popui.MenuItem() {
			@popui.Avatar(props.Avatar{Initial: "S"})
			<span>Staging</span>
		}
	}
}
