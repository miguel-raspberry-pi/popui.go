package examples

import (
	"github.com/miguel-raspberry-pi/popui.go"
	"github.com/miguel-raspberry-pi/popui.go/props"
)

templ CardDashboardExample() {
	@popui.Card() {
		@popui.CardHeader(props.CardHeader{
			Title:    "Monthly Overview",
			Subtitle: "Key performance metrics",
		})
		@popui.CardContent() {
			@popui.CardStats(props.CardStats{Columns: 3}) {
				@popui.CardStat(props.CardStat{Label: "Revenue", Value: "$12.5k"})
				@popui.CardStat(props.CardStat{Label: "Orders", Value: "243"})
				@popui.CardStat(props.CardStat{Label: "Customers", Value: "89"}) {
					@popui.TagStatus(props.TagStatus{Label: "+12%", Status: "green"})
				}
			}
		}
	}
}
