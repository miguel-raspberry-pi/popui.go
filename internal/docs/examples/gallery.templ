package examples

import (
	"encoding/base64"
	"fmt"

	"github.com/miguel-raspberry-pi/popui.go"
	"github.com/miguel-raspberry-pi/popui.go/props"
)

// Click a thumbnail to switch the photo, or the photo to open the
// fullscreen viewer (arrow keys browse, Esc closes). Real listings pass
// image URLs, with smaller Thumb URLs when available.
templ GalleryExample() {
	@popui.Block(props.Block{Class: "w-full max-w-xl"}) {
		@popui.Gallery(props.Gallery{
			Images: []props.GalleryImage{
				{Src: galleryPlaceholder("Living room", 205), Alt: "Living room with a balcony", Caption: "Living room, 24 m² with balcony"},
				{Src: galleryPlaceholder("Kitchen", 25), Alt: "Open kitchen", Caption: "Open kitchen, renovated 2024"},
				{Src: galleryPlaceholder("Bedroom", 145), Alt: "Main bedroom", Caption: "Main bedroom"},
				{Src: galleryPlaceholder("Bathroom", 265), Alt: "Bathroom with shower"},
				{Src: galleryPlaceholder("Terrace", 45), Alt: "Shared roof terrace", Caption: "Shared roof terrace"},
			},
		})
	}
}

// galleryPlaceholder draws a stand-in photo as an SVG data URI so the docs
// need no image files.
func galleryPlaceholder(label string, hue int) string {
	svg := fmt.Sprintf(`<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="900" viewBox="0 0 1200 900">`+
		`<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1">`+
		`<stop offset="0" stop-color="hsl(%[1]d 55%% 72%%)"/><stop offset="1" stop-color="hsl(%[2]d 45%% 38%%)"/>`+
		`</linearGradient></defs><rect width="1200" height="900" fill="url(#g)"/>`+
		`<path d="M0 700 L320 430 L560 640 L800 380 L1200 720 V900 H0Z" fill="hsl(%[1]d 30%% 22%% / .45)"/>`+
		`<circle cx="930" cy="220" r="90" fill="hsl(50 90%% 85%% / .8)"/>`+
		`<text x="60" y="840" font-family="Inter, sans-serif" font-size="64" font-weight="600" fill="white">%[3]s</text></svg>`,
		hue, (hue+40)%360, label)
	return "data:image/svg+xml;base64," + base64.StdEncoding.EncodeToString([]byte(svg))
}
