package examples

import (
	"github.com/miguel-raspberry-pi/popui.go"
	"github.com/miguel-raspberry-pi/popui.go/props"
)

templ InputWithLabelExample() {
	@popui.Input(props.Input{
		ID:          "email-with-label",
		Label:       "Email",
		Type:        "email",
		Placeholder: "email@example.com",
	})
}
