package popui

import (
	"github.com/invopop/icons"
	"github.com/miguel-raspberry-pi/popui.go/props"
	"github.com/miguel-raspberry-pi/popui.go/tailwind"
)

// VideoStream plays a live WebRTC video stream negotiated with a WHEP-style
// endpoint. popui.js connects, reconnects with backoff when the stream drops
// or stalls, pauses while the page is hidden and ends the session when the
// player leaves the page, so no consumer script is needed.
//
// The root's data-state attribute reports what the player is doing:
// "connecting", "live", "offline", "idle" (Manual players before Play,
// and players paused with the controls) or "stopped" (the server-side live
// switch at ControlURL is off). The overlays are shown from it in CSS.
//
// With ControlURL the player also shows a Stop live / Start live button that
// turns the stream off for every viewer, and polls the switch so all
// players follow it. With Controls it offers a Snapshot button (unless
// NoSnapshot) that downloads the current frame as a PNG.
templ VideoStream(opts ...props.VideoStream) {
	{{ p := props.First(opts) }}
	{{ title := videoStreamTitle(p.Title) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			tailwind.Merge(
				"popui-video-stream relative w-full overflow-hidden rounded-lg bg-background-default-negative text-foreground-inverse",
				p.Class,
			),
		}
		style={ "aspect-ratio: " + videoStreamAspectRatio(p.AspectRatio) }
		role="region"
		aria-label={ title }
		data-video-stream
		data-whep-url={ p.WHEPURL }
		if p.Manual {
			data-manual
			data-state="idle"
		} else {
			data-state="connecting"
		}
		if p.ICEServers != "" {
			data-ice-servers={ p.ICEServers }
		}
		if p.ControlURL != "" {
			data-control-url={ p.ControlURL }
		}
		{ p.Attributes... }
	>
		<video
			class="block size-full object-contain"
			playsinline
			muted
			autoplay
			disablepictureinpicture
			aria-label={ title }
		></video>
		<div data-video-stream-overlay="connecting" class="popui-video-stream__overlay absolute inset-0 flex-col items-center justify-center gap-2 bg-background-default-negative/70 text-sm text-foreground-inverse-secondary" role="status">
			@LoadingIcon()
			<span>Connecting…</span>
		</div>
		<div data-video-stream-overlay="live" class="popui-video-stream__overlay absolute top-2 left-2 items-center gap-1.5 rounded px-1.5 py-0.5 bg-background-default-negative/70 text-xs font-medium text-foreground-inverse">
			<span class="size-1.5 rounded-full bg-background-critical-bold" aria-hidden="true"></span>
			<span>Live</span>
		</div>
		<div data-video-stream-overlay="offline" class="popui-video-stream__overlay absolute inset-0 flex-col items-center justify-center gap-3 p-4 text-center bg-background-default-negative/80" role="alert">
			<p class="text-base font-medium text-foreground-inverse">Stream offline</p>
			<p data-video-stream-message class="text-sm text-foreground-inverse-secondary">The camera isn't streaming right now.</p>
			@Button(props.Button{Type: "button", Variant: props.ButtonVariantInverse, Size: props.ButtonSizeSmall, Attributes: templ.Attributes{"data-video-stream-retry": true}}) {
				@icons.Reload()
				<span>Retry</span>
			}
		</div>
		<div data-video-stream-overlay="idle" class="popui-video-stream__overlay absolute inset-0 items-center justify-center">
			@Button(props.Button{Type: "button", Variant: props.ButtonVariantInverse, Attributes: templ.Attributes{"data-video-stream-play": true, "aria-label": "Play " + title}}) {
				@videoStreamPlayIcon()
				<span>Play</span>
			}
		</div>
		if p.ControlURL != "" {
			<div data-video-stream-overlay="stopped" class="popui-video-stream__overlay absolute inset-0 flex-col items-center justify-center gap-3 p-4 text-center bg-background-default-negative/80" role="status">
				<p class="text-base font-medium text-foreground-inverse">Live view stopped</p>
				<p class="text-sm text-foreground-inverse-secondary">The camera is off for everyone until it's started again.</p>
				@Button(props.Button{Type: "button", Variant: props.ButtonVariantInverse, Size: props.ButtonSizeSmall, Attributes: templ.Attributes{"data-video-stream-start": true}}) {
					@videoStreamPlayIcon()
					<span>Start live</span>
				}
			</div>
		}
		if p.Controls || p.ControlURL != "" {
			<div data-video-stream-controls class="popui-video-stream__controls absolute right-2 bottom-2 flex items-center gap-1">
				if p.ControlURL != "" {
					@Button(props.Button{Type: "button", Variant: props.ButtonVariantInverse, Size: props.ButtonSizeSmall, Attributes: templ.Attributes{"data-video-stream-live": true, "title": "Turn the camera off for every viewer"}}) {
						<span data-video-stream-live-label="stop" class="contents">
							@icons.Stop()
							<span>Stop live</span>
						</span>
						<span data-video-stream-live-label="start" class="contents">
							@videoStreamPlayIcon()
							<span>Start live</span>
						</span>
					}
				}
				if p.Controls {
					if !p.NoSnapshot {
						@Button(props.Button{Type: "button", Variant: props.ButtonVariantInverse, Size: props.ButtonSizeIcon, Disabled: true, Attributes: templ.Attributes{"data-video-stream-snapshot": true, "aria-label": "Take snapshot", "title": "Take snapshot"}}) {
							@videoStreamSnapshotIcon()
						}
					}
					@Button(props.Button{Type: "button", Variant: props.ButtonVariantInverse, Size: props.ButtonSizeIcon, Attributes: templ.Attributes{"data-video-stream-toggle": true, "aria-label": "Pause", "title": "Pause"}}) {
						<span data-video-stream-icon="pause">
							@videoStreamPauseIcon()
						</span>
						<span data-video-stream-icon="play">
							@videoStreamPlayIcon()
						</span>
					}
					@Button(props.Button{Type: "button", Variant: props.ButtonVariantInverse, Size: props.ButtonSizeIcon, Attributes: templ.Attributes{"data-video-stream-fullscreen": true, "aria-label": "Fullscreen", "title": "Fullscreen"}}) {
						@icons.Expand()
					}
				}
			</div>
		}
		if p.Controls && !p.NoSnapshot {
			@Toast(props.Toast{Type: props.ToastTypeSuccess, Message: "Snapshot saved", Attributes: templ.Attributes{"data-video-stream-toast": true}})
		}
	</div>
}

templ videoStreamPlayIcon() {
	<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5 3.5v9a.5.5 0 0 0 .77.42l7-4.5a.5.5 0 0 0 0-.84l-7-4.5A.5.5 0 0 0 5 3.5Z"></path></svg>
}

templ videoStreamSnapshotIcon() {
	<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" aria-hidden="true"><path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h1.6l1-1.5h3.8l1 1.5h1.6A1.5 1.5 0 0 1 14 5.5v6a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 11.5v-6Z"></path><circle cx="8" cy="8.5" r="2.25"></circle></svg>
}

templ videoStreamPauseIcon() {
	<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="4" y="3" width="3" height="10" rx="0.75"></rect><rect x="9" y="3" width="3" height="10" rx="0.75"></rect></svg>
}

func videoStreamTitle(title string) string {
	if title == "" {
		return "Live video"
	}
	return title
}

func videoStreamAspectRatio(ratio string) string {
	if ratio == "" {
		return "16/9"
	}
	return ratio
}
